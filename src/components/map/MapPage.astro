---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmbedLayout from "../../layouts/EmbedLayout.astro";
import { mapLibreContent, type MapLocale } from "../../data/mapLibre";
import { internalUrl, routes } from "../../utils/urls";
import { getEntry, render } from "astro:content";
import mapMeta from "../../../public/generated/map-meta.json";
import { siteSettings } from "../../data/siteSettings";

interface Props { locale: MapLocale; embedded?: boolean }
const { locale, embedded = false } = Astro.props;
const copy = mapLibreContent[locale];
const palette = ["#193754", "#2f718c", "#3d9d8b", "#83c77a", "#e5d875"];
const Layout = embedded ? EmbedLayout : BaseLayout;
const fullMapLabel = { en: "Open full map", es: "Abrir mapa completo", ca: "Obre el mapa complet" }[locale];
const shareLabels = {
  en: { button: "Share map", heading: "Share this view", link: "Link to this view", copyLink: "Copy link", embed: "Embed on a website", copyCode: "Copy embed code", hint: "Paste this code into an HTML block on your website.", copied: "Copied to clipboard.", manual: "Select and copy the text above.", staging: "Staging links are for review, not publication.", frameTitle: "H-MIP Explore interactive map" },
  es: { button: "Compartir mapa", heading: "Compartir esta vista", link: "Enlace a esta vista", copyLink: "Copiar enlace", embed: "Insertar en un sitio web", copyCode: "Copiar código", hint: "Pega este código en un bloque HTML de tu sitio web.", copied: "Copiado al portapapeles.", manual: "Selecciona y copia el texto de arriba.", staging: "Los enlaces de prueba son para revisión, no para publicación.", frameTitle: "Mapa interactivo de H-MIP Explora" },
  ca: { button: "Comparteix el mapa", heading: "Comparteix aquesta vista", link: "Enllaç a aquesta vista", copyLink: "Copia l’enllaç", embed: "Insereix en un lloc web", copyCode: "Copia el codi", hint: "Enganxa aquest codi en un bloc HTML del teu lloc web.", copied: "Copiat al porta-retalls.", manual: "Selecciona i copia el text de dalt.", staging: "Els enllaços de prova són per revisar, no per publicar.", frameTitle: "Mapa interactiu d’H-MIP Explora" },
}[locale];
const methodEntry = await getEntry("mapMethods", locale);
if (!methodEntry) throw new Error(`Missing approved map method: ${locale}`);
const { Content: MethodContent } = await render(methodEntry);
const mapLabels = {
  en: { lead: "Explore monthly model estimates across Catalonia by H3 cell or municipality.", provisional: "Provisional model", period: "Period", units: "Units", sources: "Sources", license: "Model estimates by the Human-Mosquito Interaction Project, CC0 1.0. A citable version with a DOI will follow.", boundaries: "Municipal and comarca boundaries © ICGC, Divisions administratives (1:250,000), CC BY 4.0. Basemap © OpenStreetMap contributors (ODbL).", h3: "original resolution-7 H3 cells", municipality: "municipalities with model values joined to ICGC boundaries", search: "Accents are optional in municipality search." },
  es: { lead: "Explora las estimaciones mensuales del modelo en Cataluña por celda H3 o municipio.", provisional: "Modelo provisional", period: "Periodo", units: "Unidades", sources: "Fuentes", license: "Estimaciones del modelo del Human-Mosquito Interaction Project, CC0 1.0. Próximamente habrá una versión citable con DOI.", boundaries: "Límites municipales y comarcales © ICGC, Divisions administratives (1:250.000), CC BY 4.0. Mapa base © colaboradores de OpenStreetMap (ODbL).", h3: "celdas H3 originales de resolución 7", municipality: "municipios con valores del modelo unidos a límites del ICGC", search: "Los acentos son opcionales en la búsqueda de municipios." },
  ca: { lead: "Explora les estimacions mensuals del model a Catalunya per cel·la H3 o municipi.", provisional: "Model provisional", period: "Període", units: "Unitats", sources: "Fonts", license: "Estimacions del model del Human-Mosquito Interaction Project, CC0 1.0. Aviat hi haurà una versió citable amb DOI.", boundaries: "Límits municipals i comarcals © ICGC, Divisions administratives (1:250.000), CC BY 4.0. Mapa base © col·laboradors d'OpenStreetMap (ODbL).", h3: "cel·les H3 originals de resolució 7", municipality: "municipis amb valors del model units a límits de l'ICGC", search: "Els accents són opcionals a la cerca de municipis." },
}[locale];
const number = new Intl.NumberFormat({ en: "en-GB", es: "es-ES", ca: "ca-ES" }[locale]);
const staticTableUrl = internalUrl({ en: "en/map-table/", es: "es/tabla-mapa/", ca: "taula-mapa/" }[locale]);
const staticTableLabel = { en: "Table available without JavaScript", es: "Tabla disponible sin JavaScript", ca: "Taula disponible sense JavaScript" }[locale];
const h3Meta = mapMeta.layers.albopictus_h3;
---

<Layout locale={locale} title={`${copy.title} — H-MIP ${locale === "en" ? "Explore" : "Explora"}`} description={mapLabels.lead}>
  <div
    class:list={["wrap page map-page", { embedded }]}
    data-map-explorer
    data-locale={locale}
    data-h3-url={internalUrl("generated/h3.geojson")}
    data-municipalities-url={internalUrl("generated/municipalities.geojson")}
    data-comarques-url={internalUrl("generated/comarques.geojson")}
    data-map-meta-url={internalUrl("generated/map-meta.json")}
  >
    <header class="map-intro">
      <div class="page-head">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="lead">{mapLabels.lead}</p>
      </div>
      {siteSettings.modelProvisional && <span class="demo-tag">{mapLabels.provisional}</span>}
      {embedded && <a class="full-map-link" href={routes[locale].map} target="_blank" rel="noopener noreferrer">{fullMapLabel} ↗</a>}
    </header>

    <div class="map-toolbar">
      <div class="view-switch" role="group" aria-label={copy.viewLabel}>
        <button type="button" data-view="map" aria-pressed="true">{copy.mapView}</button>
        <button type="button" data-view="table" aria-pressed="false">{copy.tableView}</button>
      </div>
      {!embedded && <details class="map-share" data-map-share data-embed-url={internalUrl(`embed/${locale}/map/`)} data-frame-title={shareLabels.frameTitle} data-copied={shareLabels.copied} data-manual={shareLabels.manual}>
        <summary>{shareLabels.button} <span aria-hidden="true">↗</span></summary>
        <div class="share-panel">
          <h2>{shareLabels.heading}</h2>
          {siteSettings.isStaging && <p class="share-staging">{shareLabels.staging}</p>}
          <label for="share-map-link">{shareLabels.link}</label>
          <div class="share-row"><input id="share-map-link" data-share-link type="text" readonly /><button type="button" data-copy-link>{shareLabels.copyLink}</button></div>
          <label for="share-map-code">{shareLabels.embed}</label>
          <textarea id="share-map-code" data-share-code readonly rows="4"></textarea>
          <button type="button" data-copy-code>{shareLabels.copyCode}</button>
          <p class="fine">{shareLabels.hint}</p>
          <p class="share-status" data-share-status role="status" aria-live="polite"></p>
        </div>
      </details>}
    </div>
    <p class="static-table-link"><a href={staticTableUrl}>{staticTableLabel}</a></p>
    <noscript><p class="no-script">{staticTableLabel}: <a href={staticTableUrl}>{staticTableUrl}</a></p><style>.map-status{display:none}</style></noscript>

    <div class="map-shell">
      <aside class="map-sidebar" aria-label={copy.controls}>
        <section class="control-group" aria-labelledby="layer-label">
          <span class="map-step">{copy.layerStep}</span>
          <h2 class="control-label" id="layer-label">{copy.layerLabel}</h2>
          <div class="segmented" role="group" aria-label={copy.layerLabel}>
            <button type="button" data-layer="h3" aria-pressed="true">{copy.h3Layer}</button>
            <button type="button" data-layer="municipality" aria-pressed="false">{copy.municipalityLayer}</button>
          </div>
          <p class="fine" data-layer-hint>{number.format(h3Meta.featureCount)} {mapLabels.h3}.</p>
        </section>

        <form class="control-group search" data-search-form>
          <span class="map-step">{copy.searchStep}</span>
          <label class="control-label" for="map-place-search">{copy.searchLabel}</label>
          <div class="search-row">
            <div class="search-input-wrap">
              <input id="map-place-search" data-search type="search" role="combobox" aria-autocomplete="list" aria-controls="map-search-results" aria-expanded="false" autocomplete="off" placeholder={copy.searchPlaceholder} />
              <button class="search-clear" type="button" data-search-clear aria-label={copy.searchClear} hidden>×</button>
              <div class="search-results" id="map-search-results" role="listbox" aria-label={copy.searchLabel} hidden></div>
            </div>
            <button class="search-submit" type="submit">{copy.searchButton}</button>
          </div>
          <p class="fine">{mapLabels.search}</p>
          <p class="fine search-status" data-search-status role="status"></p>
        </form>

        <section class="control-group" aria-labelledby="time-label">
          <span class="map-step">{copy.timeStep}</span>
          <div class="month-row">
            <div><h2 class="control-label" id="time-label">{copy.timeLabel}</h2><strong class="month-name" data-month-name>{copy.months[7]}</strong></div>
            <button class="play-btn" type="button" data-play aria-pressed="false">▶ {copy.play}</button>
          </div>
          <input type="range" data-month min="1" max="12" value="8" step="1" aria-label={copy.monthAria} />
          <div class="month-ticks" aria-hidden="true">
            {copy.monthShort.map((month, index) => <span class={index === 7 ? "active" : ""}>{month.slice(0, 1)}</span>)}
          </div>
        </section>

        <section class="control-group" aria-labelledby="legend-title">
          <span class="map-step">{copy.legendStep}</span>
          <h2 class="control-label" id="legend-title" data-legend-title>…</h2>
          <div class="legend-ramp" aria-hidden="true">{palette.map((color) => <i style={`background:${color}`}></i>)}</div>
          <div class="legend-labels" data-legend-labels>{palette.map(() => <span>…</span>)}</div>
          <p class="fine">{copy.legendNote}</p>
        </section>

        <section class="selected-card" aria-labelledby="selected-title">
          <span class="map-step">{copy.selectedStep}</span>
          <p class="fine" data-select-prompt>{copy.selectPrompt}</p>
          <div data-selected-card hidden>
            <h2 class="selected-name" id="selected-title" data-selected-name></h2>
            <p class="fine" data-selected-detail></p>
            <p class="selected-reading" data-selected-summary aria-live="polite"></p>
            <p class="fine" data-selected-confidence></p>
            <h3 class="profile-title">{copy.monthlyProfile}</h3>
            <ol class="mini-month" data-profile aria-label={copy.monthlyProfile}>
              {copy.months.map((month) => <li><span class="profile-bar" aria-hidden="true"></span><span class="profile-month">{month}</span><span data-profile-value></span></li>)}
            </ol>
            <button class="show-on-map" type="button" data-show-on-map>{copy.showOnMap}</button>
          </div>
        </section>

        <details class="method">
          <summary><span class="map-step">{copy.methodStep}</span><strong>{copy.methodTitle}</strong></summary>
          <div class="method-copy"><MethodContent /></div>
          <dl class="method-meta">
            <div><dt>{mapLabels.period}</dt><dd>{h3Meta.period}</dd></div>
            <div><dt>{mapLabels.units}</dt><dd>{h3Meta.units[locale]}</dd></div>
            <div><dt>{mapLabels.sources}</dt><dd>{mapLabels.license} {mapLabels.boundaries}</dd></div>
          </dl>
        </details>
      </aside>

      <div class="map-stage" data-map-stage>
        <div class="production-map" data-maplibre-map role="region" aria-label={copy.mapAria}></div>
        <p class="map-caption">{h3Meta.period} · ICGC</p>
        <p class="map-status" data-map-status role="status">{copy.loading}</p>
      </div>

      <section class="table-panel" data-table-panel aria-label={copy.tableLabel} hidden>
        <div class="table-toolbar">
          <label for="map-table-filter">{copy.tableFilter}</label>
          <input id="map-table-filter" data-table-filter type="search" placeholder={copy.searchPlaceholder} />
          <p data-table-count role="status"></p>
        </div>
        <div class="table-scroll" role="region" aria-label={copy.tableLabel} tabindex="0">
          <table>
            <caption data-table-caption>{copy.tableCaption} {copy.months[7]}</caption>
            <thead><tr>
              <th scope="col" data-sort-column="name" aria-sort="ascending"><button type="button" data-sort="name">{copy.municipality} ↕</button></th>
              <th scope="col" data-sort-column="comarca"><button type="button" data-sort="comarca">{copy.comarca} ↕</button></th>
              <th scope="col" data-sort-column="value" class="num"><button type="button" data-sort="value">{copy.tableValue} ↕</button></th>
              <th scope="col" data-sort-column="confidence"><button type="button" data-sort="confidence">{copy.confidence} ↕</button></th>
            </tr></thead>
            <tbody data-table-body></tbody>
          </table>
          <p class="table-empty" data-table-empty hidden>{copy.tableEmpty}</p>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script src="../../scripts/mapLibreExplorer.ts"></script>

<style>
  .map-page{padding-top:34px}
  .map-page.embedded{max-width:none;padding:12px}
  .embedded .map-intro{align-items:center;margin-bottom:9px}
  .embedded .page-head{gap:3px}
  .embedded .page-head .eyebrow,.embedded .page-head .lead{display:none}
  .embedded .page-head h1{font-size:1.25rem}
  .embedded .map-shell{height:calc(100vh - 100px);min-height:430px}
  .full-map-link{margin-left:auto;font-size:.74rem;font-weight:700;white-space:nowrap}
  .map-intro{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:20px}
  .page-head{display:grid;gap:10px;max-width:760px}
  .page-head h1{font-size:clamp(2.4rem,4.4vw,4.1rem)}
  .map-intro .demo-tag{flex:none}
  .map-toolbar{position:relative;z-index:5;display:flex;align-items:start;gap:12px;margin-bottom:12px}
  .view-switch,.segmented{display:inline-flex;overflow:hidden;border:1px solid var(--line-strong);border-radius:7px}
  .map-share summary{display:flex;align-items:center;gap:8px;min-height:40px;padding:7px 13px;border:1px solid var(--line-strong);border-radius:7px;background:var(--surface-soft);color:var(--teal);font-size:.78rem;font-weight:700;cursor:pointer;list-style:none}
  .map-share summary::-webkit-details-marker{display:none}
  .map-share summary:hover,.map-share[open] summary{border-color:var(--teal)}
  .share-panel{position:absolute;top:calc(100% + 6px);left:0;display:grid;gap:9px;width:min(440px,100%);padding:16px;border:1px solid var(--line-strong);border-radius:9px;background:var(--surface);box-shadow:0 14px 30px rgba(0,0,0,.3)}
  .share-panel h2{font:650 1.18rem/1.3 var(--serif)}
  .share-panel label{font-size:.78rem;font-weight:700}
  .share-row{display:flex;gap:6px}
  .share-panel input,.share-panel textarea{min-width:0;padding:8px;border:1px solid var(--line-strong);border-radius:6px;background:var(--surface-soft);color:var(--ink);font:.74rem/1.45 var(--mono)}
  .share-panel input{flex:1}
  .share-panel textarea{width:100%;resize:vertical}
  .share-panel button{justify-self:start;padding:7px 10px;border:1px solid var(--line-strong);border-radius:6px;background:var(--surface-soft);color:var(--teal);font-size:.75rem;font-weight:700;cursor:pointer}
  .share-panel button:hover{border-color:var(--teal)}
  .share-panel .fine,.share-status{font-size:.73rem}
  .share-staging{color:var(--ink-2);font-size:.75rem}
  .share-status:empty{display:none}
  .static-table-link{margin:-4px 0 14px;font-size:.78rem}.no-script{padding:12px;border:1px solid var(--line);color:var(--ink)}
  .view-switch button,.segmented button{min-height:38px;padding:7px 13px;border:0;border-right:1px solid var(--line-strong);background:transparent;color:var(--ink-2);font-size:.78rem;font-weight:700;cursor:pointer}
  .view-switch button:last-child,.segmented button:last-child{border-right:0}
  .view-switch button[aria-pressed="true"],.segmented button[aria-pressed="true"]{background:var(--teal-soft);color:var(--teal)}
  .view-switch button:hover,.segmented button:hover{background:var(--surface-soft)}
  .map-shell{display:grid;grid-template-columns:320px minmax(0,1fr);height:760px;overflow:hidden;background:var(--surface);border:1px solid var(--line);border-radius:12px}
  .map-sidebar{display:grid;grid-template-columns:minmax(0,1fr);align-content:start;gap:22px;overflow:auto;padding:22px;border-right:1px solid var(--line)}
  .map-step{color:var(--ink-3);font:650 .66rem/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase}
  .control-group{display:grid;min-width:0;gap:9px}
  .control-group+.control-group{padding-top:18px;border-top:1px solid var(--line)}
  .control-label{font:720 .84rem/1.3 var(--sans)}
  .fine{color:var(--ink-3);font-size:.8rem;line-height:1.5}
  .search-row{display:flex;gap:6px}
  .search-input-wrap{position:relative;flex:1;min-width:0}
  .search input,.table-toolbar input{width:100%;min-height:38px;padding:7px 28px 7px 9px;border:1px solid var(--line-strong);border-radius:6px;background:var(--surface-soft);color:var(--ink);font-size:.79rem}
  .search input::placeholder,.table-toolbar input::placeholder{color:var(--ink-3)}
  .search-clear{position:absolute;top:3px;right:4px;width:28px;height:30px;border:0;background:transparent;color:var(--ink-2);cursor:pointer}
  .search-submit,.play-btn,.show-on-map{padding:6px 10px;border:1px solid var(--line-strong);border-radius:6px;background:var(--surface-soft);color:var(--ink);font-size:.75rem;font-weight:700;cursor:pointer}
  .search-submit:hover,.play-btn:hover,.show-on-map:hover{border-color:var(--teal);color:var(--teal)}
  .search-results{position:absolute;top:calc(100% + 3px);left:0;z-index:20;width:min(400px,calc(100vw - 48px));max-height:280px;overflow:auto;padding:5px;border:1px solid var(--line-strong);border-radius:7px;background:var(--surface);box-shadow:0 12px 24px rgba(0,0,0,.35)}
  .search-status:empty{display:none}
  .month-row{display:flex;align-items:end;justify-content:space-between;gap:10px}
  .month-row>div{display:grid;gap:3px}
  .month-name{font:650 1.15rem/1.3 var(--serif)}
  .control-group input[type="range"]{width:100%;accent-color:var(--teal)}
  .month-ticks{display:grid;grid-template-columns:repeat(12,1fr);color:var(--ink-3);font:.6rem var(--mono);text-align:center}
  .month-ticks .active{color:var(--ink);font-weight:800}
  .legend-ramp{display:grid;grid-template-columns:repeat(5,1fr);gap:2px}
  .legend-ramp i{height:11px}
  .legend-ramp i:first-child{border-radius:3px 0 0 3px}
  .legend-ramp i:last-child{border-radius:0 3px 3px 0}
  .legend-labels{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;color:var(--ink-2);font-size:.61rem;line-height:1.3;white-space:pre-line}
  .selected-card{display:grid;gap:8px;padding-top:18px;border-top:1px solid var(--line)}
  .selected-card>div{display:grid;gap:8px}
  .selected-name{font:650 1.28rem/1.2 var(--serif);overflow-wrap:anywhere}
  .selected-reading{font-weight:700;color:var(--ink)}
  .profile-title{margin-top:6px;font-size:.77rem}
  .mini-month{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));align-items:end;gap:4px;height:98px;margin:0;padding:0;list-style:none}
  .mini-month li{display:flex;flex-direction:column;justify-content:end;align-items:center;gap:4px;height:100%;min-width:0;font:.58rem var(--mono);color:var(--ink-3)}
  .mini-month li.is-current{color:var(--ink);font-weight:800}
  .profile-bar{display:block;width:100%;min-height:2px;border-radius:2px 2px 0 0;background:var(--teal)}
  .profile-month{overflow:hidden;width:100%;text-align:center;white-space:nowrap}
  .mini-month [data-profile-value]{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .show-on-map{justify-self:start;margin-top:4px}
  .method{padding-top:14px;border-top:1px solid var(--line)}
  .method summary{display:flex;align-items:center;gap:8px;min-height:34px;color:var(--teal);cursor:pointer;font-size:.82rem}
  .method-copy{display:grid;gap:10px;padding-top:9px;color:var(--ink-2);font-size:.8rem;line-height:1.55}
  .method-copy :global(p){margin:0 0 8px}
  .method-meta{display:grid;gap:9px;margin-top:16px;font-size:.78rem}
  .method-meta div{display:grid;gap:2px}.method-meta dt{color:var(--ink);font-weight:700}.method-meta dd{margin:0;color:var(--ink-2)}
  .map-stage{position:relative;min-width:0;min-height:0;overflow:hidden;background:#0a1d19}
  .production-map{width:100%;height:100%;min-height:620px;background:#0a1d19}
  .map-caption{position:absolute;top:12px;left:12px;z-index:1;max-width:calc(100% - 84px);padding:5px 8px;border-radius:5px;background:rgba(7,21,18,.9);color:var(--ink-2);font-size:.68rem;pointer-events:none}
  .map-status{position:absolute;top:50%;left:50%;z-index:2;transform:translate(-50%,-50%);max-width:min(360px,90%);padding:10px 14px;border-radius:7px;background:rgba(7,21,18,.94);color:var(--ink);text-align:center;font-size:.9rem}
  .map-status[hidden],.map-stage[hidden],.table-panel[hidden],.selected-card [hidden],.search-results[hidden],.search-clear[hidden],.table-empty[hidden]{display:none}
  .table-panel{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden}
  .table-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;padding:14px;border-bottom:1px solid var(--line)}
  .table-toolbar label{font-size:.8rem;font-weight:700}
  .table-toolbar input{width:min(320px,100%);padding-right:9px}
  .table-toolbar p{margin-left:auto;color:var(--ink-3);font-size:.72rem}
  .table-scroll{min-width:0;overflow:auto}
  table{width:100%;border-collapse:collapse;font-size:.78rem}
  caption{padding:12px 14px;color:var(--ink-2);text-align:left;font-weight:700}
  th,td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  thead th{position:sticky;top:0;z-index:2;background:var(--surface-soft)}
  thead button{padding:0;border:0;background:transparent;color:var(--ink);text-align:left;font-size:.74rem;font-weight:700;cursor:pointer}
  tbody th button{padding:0;border:0;background:transparent;color:var(--teal);text-align:left;font-size:inherit;cursor:pointer}
  tbody tr:hover{background:var(--surface-soft)}
  tbody tr.is-selected{background:var(--teal-soft)}
  .num{text-align:right;white-space:nowrap}
  .table-empty{padding:14px;color:var(--ink-2)}
  :global(.maplibregl-map){font-family:var(--sans)}
  :global(.maplibregl-ctrl-group){background:var(--surface-soft);border:1px solid var(--line-strong)}
  :global(.maplibregl-ctrl-group button){background-color:var(--surface-soft)}
  :global(.maplibregl-ctrl-attrib){background:rgba(7,21,18,.88)!important;color:var(--ink-2)}
